#!/usr/bin/env bash
# Recording stub for acli. Logs every invocation to $EVAL_CALL_LOG and answers
# with canned output so a skill can keep walking without touching real Jira.
echo "acli $*" >>"$EVAL_CALL_LOG"

# `acli auth status` and `acli jira auth status` are both valid shapes.
case "$1 $2" in
"auth status")
	echo "✓ Logged in to https://eval.atlassian.net as eval-user"
	echo "Site: https://eval.atlassian.net    Email: eval@example.com"
	exit 0
	;;
esac

case "$2 $3" in
"auth status")
	echo "✓ Logged in to https://eval.atlassian.net as eval-user"
	echo "Site: https://eval.atlassian.net    Email: eval@example.com"
	;;
"workitem view")
	if [[ "$*" == *"--json"* ]]; then
		cat <<'JSON'
{"key":"ACC-1","fields":{"summary":"Create account endpoint","status":{"name":"In Progress"},"assignee":{"displayName":"Eval User"},"description":"As a client I want to create an account.\n\nAC-001 POST /accounts with a valid body returns 201 and the created account.\nAC-002 name empty or > 100 chars returns 400.\nAC-003 negative balance returns 400."}}
JSON
	else
		cat <<'TXT'
ACC-1  Create account endpoint
Status: In Progress    Assignee: Eval User

Description:
As a client I want to create an account.

AC-001 POST /accounts with a valid body returns 201 and the created account.
AC-002 name empty or > 100 chars returns 400.
AC-003 negative balance returns 400.
TXT
	fi
	;;
"workitem search")
	echo "ACC-1  Create account endpoint  In Progress  Eval User"
	;;
"workitem transition" | "workitem assign" | "workitem comment" | "workitem create" | "workitem edit")
	echo "ACC-1 updated"
	;;
"page view")
	echo "<h1>Account service API</h1><p>eval stub page body</p>"
	;;
*)
	echo "acli: unsupported in eval stub: $*" >&2
	exit 1
	;;
esac
