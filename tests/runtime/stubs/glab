#!/usr/bin/env bash
# Recording stub for glab. Logs every invocation to $EVAL_CALL_LOG and answers
# with canned output so a skill can keep walking without touching real GitLab.
echo "glab $*" >>"$EVAL_CALL_LOG"

case "$1 $2" in
"auth status")
	echo "gitlab.com  ✓ Logged in to gitlab.com as eval-user"
	;;
"mr view")
	if [[ "$*" == *"--output json"* ]]; then
		cat <<'JSON'
{"iid":42,"title":"feat(account): add POST /accounts","description":"Creates an account.\n\nCloses ACC-1","state":"opened","source_branch":"feat/create-account","target_branch":"develop","author":{"username":"eval-user"},"web_url":"https://gitlab.example.com/org/account-service/-/merge_requests/42"}
JSON
	else
		cat <<'TXT'
feat(account): add POST /accounts !42
(opened) • eval-user • feat/create-account → develop

Creates an account.

Closes ACC-1

View this merge request: https://gitlab.example.com/org/account-service/-/merge_requests/42
TXT
	fi
	;;
"mr diff")
	cat <<'TXT'
diff --git a/internal/account/handler.go b/internal/account/handler.go
--- a/internal/account/handler.go
+++ b/internal/account/handler.go
@@ -18,6 +18,14 @@ func (h *Handler) GetAccount(w http.ResponseWriter, r *http.Request) {
+// CreateAccount serves POST /accounts.
+func (h *Handler) CreateAccount(w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	_ = json.NewDecoder(r.Body).Decode(&req)
+	acc := &Account{ID: uuid.NewString(), Name: req.Name, Balance: req.Balance}
+	w.WriteHeader(http.StatusCreated)
+	_ = json.NewEncoder(w).Encode(acc)
+}
TXT
	;;
"mr list")
	echo "Showing 1 open merge request on org/account-service"
	echo "!42  feat(account): add POST /accounts  (feat/create-account)"
	;;
"mr note" | "mr create" | "mr update" | "mr approve" | "mr merge")
	echo "https://gitlab.example.com/org/account-service/-/merge_requests/42"
	;;
"ci status" | "ci list")
	echo "(success) • pipeline #9001 • feat/create-account"
	;;
*)
	echo "glab: unsupported in eval stub: $*" >&2
	exit 1
	;;
esac
