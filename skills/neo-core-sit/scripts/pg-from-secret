#!/usr/bin/env bash
# Read Postgres connection settings from a Core/Aux SIT K8s secret (read-only helper).
#
# Usage:
#   pg-from-secret --context core-neo --service payment
#   pg-from-secret --context core-neo --namespace core-systems --secret payment-secret
#   pg-from-secret --context aux-neo --namespace sms --secret sms-service-secret
#   eval "$(pg-from-secret --context core-neo --service payment --export)"
#   pg-from-secret --context core-neo --service payment --psql -- \
#     -c "SELECT * FROM payment.audit_log ORDER BY created_at DESC LIMIT 5"
#
# Flags:
#   --context CTX   kubectl context (required)
#   --namespace NS  K8s namespace
#   --secret NAME   secret name
#   --service NAME  shortcut → secret=<name>-secret, ns default core-systems
#   --export        print export PG* lines (includes password; for eval only)
#   --with-password include password in human summary
#   --json          machine-readable JSON
#   --psql          run psql; pass SQL args after --
#   -h|--help
set -euo pipefail

CONTEXT=""
NAMESPACE=""
SECRET=""
SERVICE=""
MODE="summary"
WITH_PASSWORD=0
PSQL_ARGS=()

usage() {
  sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --context) CONTEXT="${2:-}"; shift 2 ;;
    --namespace) NAMESPACE="${2:-}"; shift 2 ;;
    --secret) SECRET="${2:-}"; shift 2 ;;
    --service) SERVICE="${2:-}"; shift 2 ;;
    --export) MODE="export"; shift ;;
    --json) MODE="json"; shift ;;
    --with-password) WITH_PASSWORD=1; shift ;;
    --psql) MODE="psql"; shift ;;
    --) shift; PSQL_ARGS=("$@"); break ;;
    -h|--help) usage 0 ;;
    *)
      if [[ -z "$SERVICE" && -z "$SECRET" && "$1" != -* ]]; then
        SERVICE="$1"; shift
      else
        echo "unknown arg: $1" >&2
        usage 2
      fi
      ;;
  esac
done

[[ -n "$CONTEXT" ]] || { echo "error: --context is required" >&2; exit 2; }

if [[ -n "$SERVICE" ]]; then
  SECRET="${SECRET:-${SERVICE}-secret}"
  NAMESPACE="${NAMESPACE:-core-systems}"
fi

if [[ -z "$NAMESPACE" || -z "$SECRET" ]]; then
  echo "error: need --namespace + --secret, or --service" >&2
  exit 2
fi

for bin in kubectl jq python3; do
  command -v "$bin" >/dev/null || { echo "error: need $bin" >&2; exit 2; }
done

RAW_JSON=$(kubectl --context "$CONTEXT" get secret "$SECRET" -n "$NAMESPACE" -o json)
TMP_JSON=$(mktemp)
trap 'rm -f "$TMP_JSON"' EXIT
printf '%s' "$RAW_JSON" >"$TMP_JSON"

CONN_JSON=$(python3 - "$TMP_JSON" <<'PY'
import base64, json, re, sys

try:
    import yaml
except ImportError:
    yaml = None

secret = json.load(open(sys.argv[1]))
data = secret.get("data") or {}
if not data:
    print("error: secret has no data", file=sys.stderr)
    sys.exit(1)

decoded = {
    k: base64.b64decode(v).decode("utf-8", errors="replace")
    for k, v in data.items()
}

def pick(*keys):
    for k in keys:
        if k in decoded and decoded[k] != "":
            return decoded[k]
    return None

conn = {
    "host": None,
    "port": "5432",
    "user": None,
    "password": None,
    "database": None,
    "sslmode": "require",
    "schema": None,
    "source": None,
}

host = pick("DB_HOST", "POSTGRES_HOST")
user = pick("DB_USER", "POSTGRES_USER")
password = pick("DB_PASSWORD", "POSTGRES_PASSWORD")
database = pick("DB_NAME", "POSTGRES_DB", "POSTGRES_DATABASE")
port = pick("DB_PORT", "POSTGRES_PORT")
schema = pick("DB_SCHEMA", "POSTGRES_SCHEMA")

if host and user:
    conn.update({
        "host": host,
        "user": user,
        "password": password,
        "database": database,
        "port": port or "5432",
        "schema": schema,
        "sslmode": pick("DB_SSLMODE", "POSTGRES_SSLMODE") or "require",
        "source": "discrete-keys",
    })
else:
    yaml_keys = [
        k for k in decoded
        if k.endswith((".yaml", ".yml")) or k in ("config", "secrets")
    ] or list(decoded.keys())
    doc = None
    used = None
    for k in yaml_keys:
        text = decoded[k]
        if yaml is not None:
            try:
                loaded = yaml.safe_load(text)
            except Exception:
                loaded = None
            if isinstance(loaded, dict):
                doc, used = loaded, k
                break
        scraped = {}
        for line in text.splitlines():
            m = re.match(
                r"\s*(host|port|user|username|password|database|dbname|sslmode|schema)\s*:\s*[\"']?([^\"'#]+?)[\"']?\s*$",
                line,
                re.I,
            )
            if m:
                scraped[m.group(1).lower()] = m.group(2).strip()
        if scraped.get("host") and (scraped.get("user") or scraped.get("username")):
            doc, used = {"postgres": scraped}, k
            break

    if not isinstance(doc, dict):
        print(
            "error: could not parse postgres settings from secret keys: "
            + ", ".join(decoded.keys()),
            file=sys.stderr,
        )
        sys.exit(1)

    pg = doc.get("postgres")
    if not isinstance(pg, dict):
        db = doc.get("database")
        if isinstance(db, dict):
            pg = db.get("postgres") if isinstance(db.get("postgres"), dict) else db
    if not isinstance(pg, dict):
        print(f"error: no postgres block in {used}", file=sys.stderr)
        sys.exit(1)

    conn.update({
        "host": pg.get("host"),
        "port": str(pg.get("port") or "5432"),
        "user": pg.get("user") or pg.get("username"),
        "password": pg.get("password"),
        "database": pg.get("database") or pg.get("dbname"),
        "sslmode": pg.get("sslmode") or "require",
        "schema": pg.get("schema"),
        "source": f"yaml:{used}",
    })

missing = [k for k in ("host", "user", "database") if not conn.get(k)]
if missing:
    print("error: missing fields: " + ", ".join(missing), file=sys.stderr)
    sys.exit(1)

print(json.dumps(conn, ensure_ascii=False))
PY
)

CONN_FILE=$(mktemp)
trap 'rm -f "$TMP_JSON" "$CONN_FILE"' EXIT
printf '%s' "$CONN_JSON" >"$CONN_FILE"

emit_exports() {
  python3 - "$CONN_FILE" <<'PY'
import json, shlex, sys
c = json.load(open(sys.argv[1]))
for key, env in [
    ("host", "PGHOST"),
    ("port", "PGPORT"),
    ("user", "PGUSER"),
    ("password", "PGPASSWORD"),
    ("database", "PGDATABASE"),
    ("sslmode", "PGSSLMODE"),
    ("schema", "PGSCHEMA"),
]:
    v = c.get(key)
    if (v is None or v == "") and env == "PGSCHEMA":
        continue
    print(f"export {env}={shlex.quote(str(v or ''))}")
PY
}

case "$MODE" in
  json)
    cat "$CONN_FILE"
    echo
    ;;
  export)
    emit_exports
    ;;
  summary)
    python3 - "$CONN_FILE" "$WITH_PASSWORD" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
wp = int(sys.argv[2])
for label, key in [
    ("source", "source"),
    ("host", "host"),
    ("port", "port"),
    ("user", "user"),
    ("database", "database"),
    ("sslmode", "sslmode"),
    ("schema", "schema"),
]:
    print(f"{label + ':':<10} {c.get(key)}")
if wp:
    print(f"{'password:':<10} {c.get('password') or ''}")
else:
    print(f"{'password:':<10} <hidden>  (pass --with-password or --export)")
PY
    ;;
  psql)
    command -v psql >/dev/null || { echo "error: psql not found" >&2; exit 2; }
    eval "$(emit_exports)"
    if [[ ${#PSQL_ARGS[@]} -eq 0 ]]; then
      PSQL_ARGS=(-c "SELECT current_user, current_database();")
    fi
    exec psql \
      "host=${PGHOST} port=${PGPORT} user=${PGUSER} dbname=${PGDATABASE} sslmode=${PGSSLMODE}" \
      "${PSQL_ARGS[@]}"
    ;;
esac
