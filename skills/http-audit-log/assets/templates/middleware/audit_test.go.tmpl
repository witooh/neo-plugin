package middleware

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/gin-gonic/gin"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"__MODULE__/internal/core/domain/audit"
)

type stubAuditRepo struct {
	inserted []*audit.AuditLog
	err      error
}

func (s *stubAuditRepo) Insert(_ context.Context, log *audit.AuditLog) error {
	s.inserted = append(s.inserted, log)
	return s.err
}

func setupAuditEngine(t *testing.T, repo audit.AuditLogRepository) *gin.Engine {
	t.Helper()
	gin.SetMode(gin.TestMode)
	r := gin.New()
	r.Use(Audit(repo))
	r.GET("/ok", func(c *gin.Context) {
		c.JSON(http.StatusOK, gin.H{"responseCode": "0000", "message": "ok"})
	})
	r.GET("/bad", func(c *gin.Context) {
		c.JSON(http.StatusBadRequest, gin.H{"responseCode": "4000", "message": "nope"})
	})
	r.POST("/echo", func(c *gin.Context) {
		c.JSON(http.StatusOK, gin.H{"status": "SUCCESS"})
	})
	return r
}

func TestAudit_SuccessWritesOneRow(t *testing.T) {
	repo := &stubAuditRepo{}
	r := setupAuditEngine(t, repo)

	w := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/ok", nil)
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)
	require.Len(t, repo.inserted, 1)
	row := repo.inserted[0]
	assert.Equal(t, "GET", row.HttpMethod())
	assert.Equal(t, "/ok", row.Route())
	assert.Equal(t, audit.AuditStatus_SUCCESS, row.Status())
	assert.Equal(t, int16(200), row.HttpStatus())
	assert.Equal(t, "0000", row.ResponseCode())
	assert.GreaterOrEqual(t, row.DurationMs(), int64(0))
}

func TestAudit_ClientErrorWritesFailedRow(t *testing.T) {
	repo := &stubAuditRepo{}
	r := setupAuditEngine(t, repo)

	w := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/bad", nil)
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusBadRequest, w.Code)
	require.Len(t, repo.inserted, 1)
	row := repo.inserted[0]
	assert.Equal(t, audit.AuditStatus_FAILED, row.Status())
	assert.Equal(t, int16(400), row.HttpStatus())
	assert.Equal(t, "4000", row.ResponseCode())
	assert.Equal(t, "nope", row.FailureReason())
}

func TestAudit_PersistErrorDoesNotFailRequest(t *testing.T) {
	repo := &stubAuditRepo{err: errors.New("db down")}
	r := setupAuditEngine(t, repo)

	w := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/ok", nil)
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)
	require.Len(t, repo.inserted, 1)
}

func TestAudit_NilWriterIsNoop(t *testing.T) {
	r := setupAuditEngine(t, nil)

	w := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/ok", nil)
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)
}

func TestAudit_OversizedContentLengthIs413AndFailed(t *testing.T) {
	repo := &stubAuditRepo{}
	r := setupAuditEngine(t, repo)

	w := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodPost, "/echo", bytes.NewReader([]byte(`{}`)))
	req.ContentLength = maxAuditBodyLimit + 1
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusRequestEntityTooLarge, w.Code)
	require.Len(t, repo.inserted, 1)
	row := repo.inserted[0]
	assert.Equal(t, audit.AuditStatus_FAILED, row.Status())
	assert.Equal(t, int16(http.StatusRequestEntityTooLarge), row.HttpStatus())
	assert.Equal(t, requestTruncatedMarker, row.RawRequest())
}

func TestExtractResponseFields_FailSoft(t *testing.T) {
	code, reason := extractResponseFields(`not-json`)
	assert.Equal(t, "", code)
	assert.Equal(t, "", reason)

	code, reason = extractResponseFields(`{"responseCode":"0000"}`)
	assert.Equal(t, "0000", code)
	assert.Equal(t, "", reason)
}

func TestExtractMetadata_DefaultEmptyObject(t *testing.T) {
	assert.Equal(t, json.RawMessage(`{}`), extractMetadata("/ok", `{}`))
}
